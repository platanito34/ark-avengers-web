---
/**
 * Plantilla para páginas de texto escritas en Markdown (p. ej. src/pages/proyecto.md).
 * En el .md basta con poner en la cabecera:
 *   layout: ../layouts/TextLayout.astro
 *   title: ...
 *   intro: ...      (puede llevar {nombre}: se sustituye por el nombre del proyecto)
 */
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { conNombre } from "../config/site";
import "../styles/pages/interior.css";

const { frontmatter } = Astro.props;
const intro = frontmatter.intro ? conNombre(frontmatter.intro) : undefined;
---
<BaseLayout title={frontmatter.title} description={intro}>
  <PageHeader title={frontmatter.title} intro={intro} />
  <section class="page-body">
    <div class="container">
      {frontmatter.provisional && (
        <p class="notice">Texto provisional. Sustitúyelo editando el fichero de esta página.</p>
      )}
      <div class="prose"><slot /></div>
    </div>
  </section>
</BaseLayout>
