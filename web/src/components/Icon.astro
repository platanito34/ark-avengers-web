---
/**
 * Iconos SVG propios (sin marcas registradas).
 * Uso: <Icon name="chat" />
 */
interface Props {
  name: "mark" | "chat" | "servers" | "flag" | "people" | "copy" | "check";
  class?: string;
}
const { name, class: className } = Astro.props;
---
{name === "mark" && (
  <svg class:list={["brand__mark", className]} viewBox="0 0 20 32" aria-hidden="true"><path fill="currentColor" d="M10 0 17 9 14 32H6L3 9Z"/><path fill="#12191b" d="M10 9.5 12.6 13 10 16.5 7.4 13Z"/></svg>
)}
{name === "chat" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H10l-6 4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" stroke-linecap="round" stroke-width="2.6"/></svg>
)}
{name === "servers" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="7"/><rect x="3" y="13" width="18" height="7"/><path d="M7 7.5h.01M7 16.5h.01M11 7.5h6M11 16.5h6" stroke-linecap="round" stroke-width="2"/></svg>
)}
{name === "flag" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>
)}
{name === "people" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M15.8 14.1c2.9.4 5.2 2.8 5.2 5.9"/></svg>
)}
{name === "copy" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12"/><path d="M16 8V4H4v12h4"/></svg>
)}
{name === "check" && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
)}
