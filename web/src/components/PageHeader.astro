---
/** Cabecera de las páginas interiores (título + introducción) */
interface Props { title: string; intro?: string }
const { title, intro } = Astro.props;
---
<section class="page-header">
  <div class="container">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
