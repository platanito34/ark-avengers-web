# Copia este fichero como .env

# De dónde saca la web el estado de los servidores:
#   fixtures -> ficheros de ejemplo de fixtures/status/ (no necesita backend)
#   api      -> el backend real (PUBLIC_API_URL)
PUBLIC_STATUS_SOURCE=fixtures

# Escenario de ejemplo por defecto en modo fixtures: normal | problemas | vacio | error
# También se puede cambiar en el navegador añadiendo ?escenario=problemas a la URL.
PUBLIC_STATUS_FIXTURE=normal

# Dirección del backend (solo en modo api)
PUBLIC_API_URL=http://localhost:8000
