# Copia este fichero como .env y rellénalo. El .env NUNCA se sube al repositorio.

# Cada cuántos segundos se consulta el estado de los servidores
POLL_INTERVAL_SECONDS=30
SOURCE_TIMEOUT_SECONDS=5

# Dirección de la web que puede llamar a la API (varias separadas por comas)
CORS_ORIGINS=http://localhost:4321

# --- Pterodactyl -------------------------------------------------------------
# simulated = usa mock/pterodactyl/*.json   |   live = panel real
PTERODACTYL_MODE=simulated
PTERODACTYL_URL=https://panel.ejemplo.com
PTERODACTYL_API_KEY=

# --- ARK RCON (jugadores conectados) -----------------------------------------
# SOLO red local: la API se niega a conectar con direcciones que no sean privadas.
# El puerto RCON nunca debe abrirse a Internet en el router.
#
# Todos los servidores comparten host (la máquina de Wings).
RCON_HOST=192.168.1.x
# Contraseña RCON = ServerAdminPassword del servidor (con RCONEnabled=True).
# Si todos usan la misma, basta con esta:
RCON_PASSWORD=
#
# Puerto RCON de cada servidor: el puerto asignado a ese servidor en Pterodactyl
# (debe coincidir con su RCONPort).
RCON_GENESIS_1_PORT=
RCON_RAGNAROK_PORT=
RCON_ASTRAEOS_PORT=
RCON_THE_ISLAND_PORT=
RCON_LOST_COLONY_PORT=
RCON_ABERRATION_PORT=
#
# Opcional: si un servidor tiene otra contraseña u otro host, añade por ejemplo:
# RCON_GENESIS_1_PASSWORD=
# RCON_GENESIS_1_HOST=
