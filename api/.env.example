# Copia este fichero como .env y rellénalo. El .env NUNCA se sube al repositorio.

# Cada cuántos segundos se consulta el estado de los servidores
POLL_INTERVAL_SECONDS=30
SOURCE_TIMEOUT_SECONDS=5

# Dirección de la web que puede llamar a la API (varias separadas por comas)
CORS_ORIGINS=http://localhost:4321

# --- Pterodactyl -------------------------------------------------------------
# simulated = usa mock/pterodactyl/*.json   |   live = panel real
PTERODACTYL_MODE=simulated
PTERODACTYL_URL=https://panel.ejemplo.com
PTERODACTYL_API_KEY=

# --- ARK RCON (cuando se implemente la fuente ark_rcon) ----------------------
# EXTINCTION_RCON_HOST=192.168.1.x
# EXTINCTION_RCON_PORT=27020
# EXTINCTION_RCON_PASSWORD=
